---
// The persistent mini-player (#15, ADR 0001), styled as the #59 decision ("bar and sheet", #60).
// It is on every page under the same persist name, so <ClientRouter /> keeps this element (and its
// focus) across navigations. The audio itself lives in src/lib/player.ts; src/lib/player-ui.ts wires
// this markup to it.
//
// Phone (below 80rem): a slim bar with back 10s and play, which opens a modal sheet with everything.
// Desktop: one full row, with no sheet. Some controls appear twice (in the bar and in the sheet);
// player-ui.ts binds and updates every copy. The sheet's copies are hidden while it is closed, and
// the row's desktop-only copies on a phone, so each name is on one visible control at a time.
import Icon from './Icon.astro';
import TranscriptPanel from './TranscriptPanel.astro';
import TranscriptToggle from './TranscriptToggle.astro';
import { getLessons, toTrack } from '../lib/lessons';
import { RATES } from '../lib/player';
import { getAllTranscripts, transcriptJsonPath } from '../lib/transcripts';

// Every lesson in episode order, for autoplay-next and the Continue card (src/lib/progress-ui.ts),
// with where its transcript is, for the transcript panel (#99, src/lib/transcript-ui.ts).
const transcripts = await getAllTranscripts();
const tracks = JSON.stringify(
  (await getLessons()).map((lesson) => ({
    ...toTrack(lesson),
    ...(transcripts.has(lesson.id) && { transcript: transcriptJsonPath(lesson.id) }),
  })),
).replaceAll('<', '\\u003c');
---

<section class="player" aria-label="Audio player" data-player data-state="idle" hidden transition:persist="player">
  <div class="line" aria-hidden="true"></div>
  <div class="row">
    <!-- Phone: the lesson, which opens the sheet. -->
    <button type="button" class="open phone" data-sheet="open" aria-haspopup="dialog" data-open-label>
      <img class="art" alt="" decoding="async" width="44" height="44" data-art />
      <span class="text">
        <span class="title" data-text="title"></span>
        <span class="meta" data-text="left"></span>
        <span class="status" aria-hidden="true" data-status></span>
      </span>
    </button>
    <!-- Desktop: the lesson, as a link. -->
    <div class="id desktop">
      <img class="art" alt="" decoding="async" width="56" height="56" data-art />
      <span class="text">
        <a class="title" data-title href="/"></a>
        <span class="meta" data-text="series"></span>
        <span class="status" aria-hidden="true" data-status></span>
      </span>
    </div>
    <div class="transport">
      <button type="button" class="ctl" data-action="back" aria-label="Back 10 seconds" aria-keyshortcuts="ArrowLeft"><Icon name="back10" /></button>
      <button type="button" class="play" data-action="toggle" aria-label="Play" aria-keyshortcuts="Space">
        <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" /><span class="spin"></span>
      </button>
      <button type="button" class="ctl desktop" data-action="forward" aria-label="Forward 30 seconds" aria-keyshortcuts="ArrowRight">
        <Icon name="forward30" />
      </button>
    </div>
    <div class="seek desktop">
      <span data-current>0:00</span>
      <input type="range" aria-label="Seek" min="0" max="0" step="1" value="0" data-seek />
      <span data-duration>0:00</span>
    </div>
    <div class="extras desktop">
      <span class="speed">
        <select data-rate aria-label="Speed" aria-keyshortcuts="< >">
          {RATES.map((rate) => <option value={rate} selected={rate === 1}>{rate}×</option>)}
        </select>
        <Icon name="chevron" />
      </span>
      <TranscriptToggle />
      <button type="button" class="ctl" data-action="mute" aria-label="Mute" aria-pressed="false" aria-keyshortcuts="M">
        <Icon name="volume" class="i-volume" /><Icon name="mute" class="i-mute" />
      </button>
    </div>
  </div>

  <!-- The one live region for the error line: the phone's visible copy is inside a button, whose
       content screen readers don't announce, so both visible copies are hidden from them. -->
  <p class="visually-hidden" role="status" data-status></p>

  <dialog class="sheet" aria-label="Player" data-sheet-dialog>
    <button type="button" class="ctl close" data-sheet="close" aria-label="Close the player"><Icon name="chevron" /></button>
    <img class="art big" alt="" decoding="async" width="288" height="288" data-art />
    <p class="sheet-title"><a data-title href="/"></a></p>
    <p class="meta" data-text="series"></p>
    <TranscriptPanel />
    <div class="sheet-seek">
      <input type="range" aria-label="Seek" min="0" max="0" step="1" value="0" data-seek />
      <span data-current>0:00</span>
      <span data-duration>0:00</span>
    </div>
    <div class="sheet-transport">
      <button type="button" class="ctl" data-action="back" aria-label="Back 10 seconds"><Icon name="back10" /></button>
      <button type="button" class="play big" data-action="toggle" aria-label="Play">
        <Icon name="play" class="i-play" /><Icon name="pause" class="i-pause" /><span class="spin"></span>
      </button>
      <button type="button" class="ctl" data-action="forward" aria-label="Forward 30 seconds"><Icon name="forward30" /></button>
    </div>
    <TranscriptToggle />
    <div class="sheet-extras">
      <span class="speed">
        <select data-rate aria-label="Speed">
          {RATES.map((rate) => <option value={rate} selected={rate === 1}>{rate}×</option>)}
        </select>
        <Icon name="chevron" />
      </span>
      <button type="button" class="ctl" data-action="mute" aria-label="Mute" aria-pressed="false">
        <Icon name="volume" class="i-volume" /><Icon name="mute" class="i-mute" />
      </button>
    </div>
  </dialog>

  <script type="application/json" data-tracks is:inline set:html={tracks} />
</section>

<script>
  import '../lib/player-ui';
  import '../lib/progress-ui';
</script>

<style>
  .player {
    /* Phone: stuck to the foot of the screen. Desktop (below): fixed over the foot of the window. */
    position: sticky;
    inset-block-end: 0;
    z-index: 4;
    overflow: hidden;
    /* The plate (src/styles/base.css) in the paper of the lesson that's loaded: player-ui.ts sets
       data-series, and base.css its --paper. Declared here, not inherited, so they use this --paper. */
    --plate-accent: var(--paper);
    --on-plate-muted: color-mix(in srgb, var(--on-plate) 72%, var(--plate));
    --plate-track: color-mix(in srgb, var(--on-plate) 22%, var(--plate));
    background: var(--plate);
    color: var(--on-plate);
  }
  .player[hidden] {
    display: none;
  }
  .player :focus-visible {
    outline-color: var(--plate-accent);
  }
  p {
    margin: 0;
  }
  a {
    color: inherit;
    text-decoration: none;
  }
  a:hover {
    text-decoration: underline;
  }

  /* The lesson's progress, along the top edge (set by player-ui.ts as --progress, 0 to 1). */
  .line {
    position: absolute;
    inset: 0 auto auto 0;
    inline-size: calc(var(--progress, 0) * 100%);
    block-size: 4px;
    background: var(--plate-accent);
  }

  .art {
    flex: none;
    inline-size: 44px;
    block-size: 44px;
    background: var(--plate-track);
    object-fit: cover;
  }
  /* No broken-image icon before the first lesson is loaded. */
  .art:not([src]) {
    visibility: hidden;
  }
  .text {
    display: grid;
    min-inline-size: 0;
  }
  .title {
    overflow: hidden;
    font-family: var(--font-serif);
    font-size: var(--text-18);
    font-weight: 700;
    line-height: 1.25;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta {
    color: var(--on-plate-muted);
    font-size: var(--text-14);
    font-variant-numeric: tabular-nums;
  }
  /* The error line takes the place of the time left. */
  .status {
    color: var(--plate-accent);
    font-size: var(--text-14);
    font-weight: 500;
  }
  .status:empty,
  [data-state='error'] .open .meta {
    display: none;
  }

  /* Icon buttons, and play/pause. */
  .ctl,
  .play {
    display: inline-grid;
    place-items: center;
    flex: none;
    inline-size: 48px;
    block-size: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: inherit;
  }
  .ctl:hover {
    background: var(--plate-track);
  }
  .play {
    background: var(--plate-accent);
    color: var(--on-plate-accent);
  }
  .play :global(.icon) {
    inline-size: 26px;
    block-size: 26px;
  }
  /* Play, pause or the loading ring, from the player's state. */
  .play :global(.i-pause),
  .spin,
  [data-state='playing'] .play :global(.i-play),
  [data-state='loading'] .play :global(.i-play) {
    display: none;
  }
  [data-state='playing'] .play :global(.i-pause) {
    display: block;
  }
  [data-state='loading'] .spin {
    display: block;
    inline-size: 24px;
    block-size: 24px;
    border: 3px solid currentColor;
    border-inline-end-color: transparent;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
  }
  @keyframes spin {
    to {
      rotate: 1turn;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-state='loading'] .spin {
      animation: none;
      border-style: dotted;
    }
  }
  .ctl :global(.i-mute),
  [aria-pressed='true'] :global(.i-volume) {
    display: none;
  }
  [aria-pressed='true'] :global(.i-mute) {
    display: block;
  }

  /* Seek: a 4px rule filled in the plate's accent up to the position (--seek), an 8×22 bar for the
     thumb, a 48px tall target. */
  input[type='range'] {
    --fill: linear-gradient(to right, var(--plate-accent) var(--seek, 0%), var(--plate-track) var(--seek, 0%));
    appearance: none;
    inline-size: 100%;
    min-inline-size: 0;
    block-size: 48px;
    margin: 0;
    background: transparent;
    cursor: pointer;
  }
  input[type='range']::-webkit-slider-runnable-track {
    block-size: 4px;
    background: var(--fill);
  }
  input[type='range']::-moz-range-track {
    block-size: 4px;
    background: var(--fill);
  }
  input[type='range']::-webkit-slider-thumb {
    appearance: none;
    inline-size: 8px;
    block-size: 22px;
    margin-block-start: -9px;
    border: 0;
    border-radius: 0;
    background: var(--plate-accent);
  }
  input[type='range']::-moz-range-thumb {
    inline-size: 8px;
    block-size: 22px;
    border: 0;
    border-radius: 0;
    background: var(--plate-accent);
  }
  input[type='range']:focus-visible {
    outline-offset: -8px;
  }

  /* Speed: a select with a 2px currentColor border. */
  .speed {
    position: relative;
    display: inline-grid;
    align-items: center;
  }
  .speed select {
    appearance: none;
    min-block-size: 48px;
    padding: 0 34px 0 var(--space-16);
    border: 2px solid currentColor;
    border-radius: var(--radius-control);
    background: none;
    color: inherit;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
  }
  .speed option {
    color: var(--ink);
    background: var(--surface);
  }
  .speed :global(.icon) {
    position: absolute;
    inset-inline-end: 10px;
    inline-size: 18px;
    block-size: 18px;
    pointer-events: none;
  }

  /* ── Phone bar ── */
  .row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-8) var(--space-8) calc(var(--space-8) + var(--player-safe-b));
  }
  .open {
    display: flex;
    flex: 1;
    align-items: center;
    gap: var(--space-12);
    min-inline-size: 0;
    min-block-size: 56px;
    padding: 0 var(--space-8) 0 0;
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: inherit;
    text-align: start;
  }
  .transport {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  /* Shown from 80rem (below); the later rules there win over this one. */
  .desktop {
    display: none;
  }

  /* ── Phone sheet ── */
  .sheet {
    inset-block: auto 0;
    /* The phone layout runs up to 80rem, so on wider screens the sheet keeps a phone's measure. */
    inline-size: min(100%, 36rem);
    max-inline-size: 100%;
    max-block-size: calc(100dvh - max(2rem, env(safe-area-inset-top)));
    margin: 0 auto;
    padding: var(--space-8) max(var(--space-24), env(safe-area-inset-left)) calc(var(--space-32) + env(safe-area-inset-bottom));
    border: 0;
    border-radius: 0;
    background: var(--plate);
    color: var(--on-plate);
    text-align: center;
  }
  .sheet[open] {
    display: grid;
    justify-items: center;
    gap: var(--space-12);
    animation: sheet-up 0.28s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .sheet::backdrop {
    background: var(--scrim);
  }
  @keyframes sheet-up {
    from {
      translate: 0 40%;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sheet[open] {
      animation: none;
    }
  }
  .close {
    justify-self: start;
  }
  .art.big {
    inline-size: min(68vw, 18rem, 34dvh);
    block-size: auto;
    aspect-ratio: 1;
    border-radius: 0;
  }
  .sheet-title {
    margin-block-start: var(--space-8);
    font-family: var(--font-serif);
    font-size: var(--text-24);
    font-weight: 700;
    line-height: 1.15;
    text-wrap: balance;
  }
  .sheet-seek {
    display: grid;
    grid-template-columns: 1fr 1fr;
    inline-size: 100%;
    color: var(--on-plate-muted);
    font-size: var(--text-14);
    font-variant-numeric: tabular-nums;
  }
  .sheet-seek input {
    grid-column: 1 / -1;
  }
  .sheet-seek [data-current],
  .sheet-seek [data-duration] {
    margin-block-start: -10px;
  }
  .sheet-seek [data-current] {
    justify-self: start;
  }
  .sheet-seek [data-duration] {
    justify-self: end;
  }
  .sheet-transport {
    display: flex;
    align-items: center;
    gap: var(--space-32);
  }
  .play.big {
    inline-size: 72px;
    block-size: 72px;
  }
  .play.big :global(.icon) {
    inline-size: 30px;
    block-size: 30px;
  }
  .sheet-extras {
    display: flex;
    justify-content: space-between;
    inline-size: 100%;
    margin-block-start: var(--space-8);
  }

  /* The transcript (#99): between the art and the controls while open, with the art smaller and the
     sheet the full height. src/lib/transcript-ui.ts sets data-transcript-open on <html>. */
  .sheet :global([data-transcript-panel]) {
    display: none;
  }
  :global(html[data-transcript-open]) .sheet[open] {
    display: flex;
    flex-direction: column;
    align-items: center;
    block-size: calc(100dvh - max(2rem, env(safe-area-inset-top)));
  }
  :global(html[data-transcript-open]) .sheet .close {
    align-self: flex-start;
  }
  /* It keeps room for a few lines even on a short phone; past that the sheet scrolls. */
  :global(html[data-transcript-open]) .sheet :global([data-transcript-panel]) {
    --transcript-fade: 1rem;
    --transcript-now-room: 0px;
    display: flex;
    min-block-size: 7rem;
    margin-block: var(--space-8);
  }
  :global(html[data-transcript-open]) .art.big {
    inline-size: min(30vw, 6rem, 10dvh);
  }
  :global(html[data-transcript-open]) .play.big {
    inline-size: 56px;
    block-size: 56px;
  }
  :global(html[data-transcript-open]) .sheet-title {
    font-size: var(--text-18);
  }

  /* The inverted print: a stock plate would glare at the foot of a dark page, so the plate is the
     lesson's paper, with its controls printed in ink. */
  @media (prefers-color-scheme: dark) {
    .player {
      --plate: var(--paper);
      --plate-accent: var(--print-ink);
      --on-plate-accent: var(--paper);
    }
  }

  /* ── Desktop row, from 80rem: everything in one row, no sheet ── */
  @media (min-width: 80rem) {
    /* Laid over the foot of the window; the page runs on behind it (src/layouts/Base.astro). */
    .player {
      position: fixed;
      inset-inline: 0;
    }
    .row {
      display: grid;
      /* 12rem minimums (not #59's 16rem and 14rem), so the row fits at 52rem (decided on #60). */
      grid-template-columns: minmax(12rem, 1.3fr) auto minmax(12rem, 1.5fr) auto;
      align-items: center;
      gap: var(--space-24);
      padding: var(--space-12) var(--space-24) calc(var(--space-12) + var(--player-safe-b));
    }
    .phone {
      display: none;
    }
    .id {
      display: flex;
      align-items: center;
      gap: var(--space-12);
      min-inline-size: 0;
    }
    .id .art {
      inline-size: 56px;
      block-size: 56px;
    }
    .transport .play {
      inline-size: 60px;
      block-size: 60px;
    }
    .seek {
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: var(--space-12);
      color: var(--on-plate-muted);
      font-size: var(--text-14);
      font-variant-numeric: tabular-nums;
    }
    .extras {
      display: flex;
      align-items: center;
      gap: var(--space-8);
    }
    .ctl.desktop {
      display: inline-grid;
    }
  }
</style>
