---
// The transcript of the playing episode (#99): one component for both places it shows, the phone
// sheet (src/components/Player.astro) and the desktop bar (TranscriptBar.astro). Its lines are
// filled in by src/lib/transcript-ui.ts from the episode's JSON, so the styles for them are global
// under the panel. A one-line key says how Portuguese and Spanish are marked. Find in transcript
// (#106) opens under it, wired in src/lib/transcript-find-ui.ts.
import Icon from './Icon.astro';
---

<div class="panel" data-transcript-panel>
  <div class="head">
    <p class="key" aria-hidden="true">
      <span><span class="lang-chip" data-lang="pt-BR">PT</span> <i lang="pt-BR">Português</i></span>
      <span><span class="lang-chip" data-lang="es">ES</span> <i lang="es">Español</i></span>
      <span>English</span>
    </p>
    <button type="button" class="find-toggle" aria-expanded="false" data-find-toggle>
      <Icon name="search" /><span class="visually-hidden">Find in transcript</span>
    </button>
  </div>
  <search class="find" aria-label="Find in transcript" data-find hidden>
    <input type="search" autocomplete="off" aria-label="Find in transcript" placeholder="Find in transcript" data-find-input />
    <span class="find-count" role="status" data-find-status></span>
    <button type="button" class="find-step" data-find-step="-1" aria-label="Previous match"><Icon name="chevron" class="up" /></button>
    <button type="button" class="find-step" data-find-step="1" aria-label="Next match"><Icon name="chevron" /></button>
  </search>
  <div class="scroll" data-transcript-scroll></div>
  <button type="button" class="now" data-transcript-now hidden>Back to now</button>
</div>

<style>
  /* It takes the colours around it (the sheet's plate, the bar's page), and fades into them at the
     top and bottom. */
  .panel {
    /* The column of times (and language chips) at the start of each line. */
    --gutter: 3.25rem;
    /* What the lines sit on, for the current find match (the phone sheet sets its plate). */
    --behind: var(--surface);
    position: relative;
    display: flex;
    flex: 1 1 0;
    flex-direction: column;
    min-block-size: 0;
    inline-size: 100%;
    /* Squeezed while the phone sheet opens or closes (src/lib/transcript-ui.ts), it keeps its lines
       inside. */
    overflow: clip;
    text-align: start;
  }
  .head {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding-inline-end: var(--space-8);
  }
  .key {
    display: flex;
    flex: 1;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-16);
    margin: 0;
    padding: var(--space-4) var(--space-12) 0 calc(var(--gutter) + var(--space-12) + 3px);
    font: 0.75rem / 1.4 var(--font-sans);
  }
  .key > span {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
  }
  /* Find in transcript: a button at the key's end opens the field under it. */
  .find-toggle,
  .find-step {
    display: grid;
    flex: none;
    place-items: center;
    inline-size: 36px;
    block-size: 36px;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .find-toggle:hover,
  .find-step:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }
  .find-toggle[aria-expanded='true'] {
    background: var(--paper);
    color: var(--print-ink);
  }
  .find-toggle :global(.icon),
  .find-step :global(.icon) {
    inline-size: 18px;
    block-size: 18px;
  }
  .find-step :global(.up) {
    rotate: 180deg;
  }
  .find {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin: var(--space-8) var(--space-8) 0 calc(var(--gutter) + var(--space-12) - var(--space-4));
    padding-inline: var(--space-12) var(--space-4);
    border: 2px solid currentColor;
    border-radius: var(--radius-control);
  }
  .find[hidden] {
    display: none;
  }
  .find:focus-within {
    outline: 2px solid var(--paper);
    outline-offset: 2px;
  }
  .find input {
    flex: 1;
    min-inline-size: 0;
    min-block-size: 36px;
    border: 0;
    background: transparent;
    color: inherit;
    outline: none;
    font: var(--text-16) / 1.2 var(--font-sans);
  }
  .find input::placeholder {
    color: inherit;
    opacity: 0.6;
  }
  .find-count {
    flex: none;
    opacity: 0.75;
    font: 500 var(--text-14) / 1 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  /* Every match on a tint of the text; the current one reversed out of it, in the colour behind the
     line (--behind: the bar's page, the sheet's plate, or the playing line's paper). */
  .panel :global(mark[data-found]) {
    border-radius: 2px;
    background: color-mix(in srgb, currentColor 22%, transparent);
    color: inherit;
    font-weight: inherit;
  }
  /* `color` stays the text's, so currentColor is; the glyphs are painted in --behind. */
  .panel :global(mark[data-found='current']) {
    background: currentColor;
    outline: 2px solid currentColor;
    -webkit-text-fill-color: var(--behind);
  }
  .panel :global(.cue[aria-current]) {
    --behind: var(--paper);
  }
  .scroll {
    /* The fade, and room under the last line for Back to now. The phone sheet, short of height,
       makes both smaller (src/components/Player.astro). */
    --fade: var(--transcript-fade, 2.5rem);
    flex: 1 1 0;
    min-block-size: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--fade) var(--space-12) calc(var(--fade) + var(--transcript-now-room, 40px)) 0;
    font: var(--text-16) / 1.45 var(--font-sans);
    mask-image: linear-gradient(transparent, #000 var(--fade), #000 calc(100% - var(--fade)), transparent);
  }
  .now {
    position: absolute;
    inset-block-end: var(--space-16);
    inset-inline-start: 50%;
    translate: -50% 0;
    min-block-size: 36px;
    padding: 0 var(--space-16);
    border: 0;
    border-radius: 999px;
    background: var(--paper);
    color: var(--print-ink);
    font: 700 var(--text-14) / 1 var(--font-sans);
    box-shadow: 0 4px 16px rgb(0 0 0 / 0.3);
    cursor: pointer;
  }
  .now[hidden] {
    display: none;
  }

  /* ── The lines (rendered by src/lib/transcript-ui.ts) ── */
  .panel :global(.cues) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .panel :global(.cue:not([data-repeat])) {
    margin-block-start: var(--space-12);
  }
  /* A line is one button: the whole line jumps there. */
  .panel :global(.line) {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    column-gap: var(--space-12);
    inline-size: 100%;
    padding: 3px var(--space-8) 3px 0;
    border: 0;
    border-inline-start: 3px solid transparent;
    border-radius: 2px;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
  }
  .panel :global(.line:hover) {
    background: color-mix(in srgb, currentColor 7%, transparent);
  }
  .panel :global(.gutter) {
    display: flex;
    grid-row: 1 / span 2;
    grid-column: 1;
    flex-direction: column;
    align-items: flex-end;
    gap: 2px;
  }
  .panel :global(.time) {
    opacity: 0.62;
    font: 500 var(--text-14) / 1.75 var(--font-sans);
    font-variant-numeric: tabular-nums;
  }
  .panel :global(.who) {
    grid-column: 2;
    padding-block-start: 3px;
    font: 700 0.75rem / 1.4 var(--font-sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .panel :global(.text) {
    grid-column: 2;
  }
  .panel :global(.empty) {
    margin: var(--space-16);
    opacity: 0.7;
  }
  /* Portuguese bold on the paper's underline (as in the notes), Spanish italic on a dotted one,
     English plain. A line all in one language also gets a chip under its time. */
  .panel :global(i[lang='pt-BR']) {
    font-style: normal;
    font-weight: 700;
    text-decoration: underline var(--paper);
    text-decoration-thickness: 0.14em;
    text-underline-offset: 0.14em;
  }
  .panel :global(i[lang='es']) {
    font-style: italic;
    text-decoration: underline dotted;
    text-decoration-thickness: 0.1em;
    text-underline-offset: 0.18em;
  }
  .panel :global(.lang-chip) {
    display: inline-block;
    padding: 1px 4px;
    border-radius: 3px;
    font: 700 0.625rem / 1.3 var(--font-sans);
    letter-spacing: 0.06em;
  }
  .panel :global(.lang-chip[data-lang='pt-BR']) {
    background: var(--paper);
    color: var(--print-ink);
  }
  .panel :global(.lang-chip[data-lang='es']) {
    box-shadow: inset 0 0 0 1px currentColor;
  }
  /* The line playing: the lesson's paper, in ink, wherever the panel is. */
  .panel :global(.cue[aria-current] .line) {
    border-inline-start-color: var(--print-ink);
    background: var(--paper);
    color: var(--print-ink);
  }
  .panel :global(.cue[aria-current] i[lang]) {
    text-decoration-color: currentColor;
  }
  .panel :global(.cue[aria-current] .time) {
    opacity: 1;
  }
  .panel :global(.cue[aria-current] .lang-chip[data-lang='pt-BR']) {
    background: var(--print-ink);
    color: var(--paper);
  }
</style>
