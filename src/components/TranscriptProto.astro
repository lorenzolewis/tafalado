---
// PROTOTYPE (#94, #99): throwaway. The transcript isn't shown on the page (only in the player); the
// page carries just each dialog turn's readings, for tap-to-seek and read-along
// (src/lib/transcript-proto-ui.ts).
import type { Turn } from '../lib/notes-schema';
import { loadTranscript } from '../lib/transcript-proto';

interface Props {
  /** The collection id, e.g. `grammar-03`. */
  id: string;
  /** The lesson's path, the player's track id, e.g. `/grammar/03`. */
  trackId: string;
  dialog: Turn[];
}

const { id, trackId, dialog } = Astro.props;
const { turns } = await loadTranscript(id, dialog);
---

<script type="application/json" data-proto-readings data-lesson={trackId} set:html={JSON.stringify(turns)} />
