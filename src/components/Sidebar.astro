---
// The sidebar (#53): the site name (the link home), every lesson in release (episode) order
// with series pills and a filter, and the footer. It is on every page under the same persist name, so <ClientRouter /> keeps it, with its scroll,
// pill and query, across navigations, like the player (ADR 0001). Wired in src/lib/sidebar-ui.ts.
import { formatDuration, isoDuration } from '../lib/format';
import { SERIES, getLessons, lessonPath } from '../lib/lessons';
import { LESSONS_ID, pagePath } from '../lib/nav';
import { SERIES_LABEL } from '../lib/series';
import Credit from './Credit.astro';
import FinishedMark from './FinishedMark.astro';
import Icon from './Icon.astro';

// The list follows the original feed's episode order (1–46), which interleaves the supplementary
// lessons with pronunciation (SOURCES.md).
const lessons = await getLessons();
const series = SERIES.map((id) => ({ id, count: lessons.filter((l) => l.data.series === id).length }));
const here = pagePath(Astro.url.pathname);
const current = (on: boolean) => (on ? 'page' : undefined);
---

<nav class="side panel" id={LESSONS_ID} aria-label="Site and lessons" data-sidebar transition:persist="sidebar">
  <div class="site-head">
    <a class="wordmark" href="/" lang="pt-BR" aria-current={current(here === '/')} data-nav="home">Tá Falado</a>
  </div>

  <div class="lessons">
    <!-- The heading row, the series pills and the filter status: pinned while the list scrolls. -->
    <div class="lessons-top">
      <!-- The filter opens in this row, in place of the heading (which stays for screen readers). -->
      <div class="lessons-head">
        <h2>Lessons</h2>
        <search class="search" id="lesson-search" hidden>
          <div class="field">
            <label for="lesson-filter" class="visually-hidden">Filter lessons</label>
            <Icon name="search" />
            <input type="search" id="lesson-filter" autocomplete="off" placeholder="nh, ão, ficar…" />
          </div>
          <!-- Opt-in (#7): also search what is said in each episode. Wired in src/lib/sidebar-ui.ts. -->
          <label class="also">
            <input type="checkbox" data-search-transcripts />
            Also search transcripts
          </label>
        </search>
        <button type="button" class="round" aria-expanded="false" aria-controls="lesson-search" data-search-toggle>
          <Icon name="search" class="i-open" /><Icon name="close" class="i-close" /><span class="visually-hidden">Filter lessons</span>
        </button>
      </div>
      <div class="pills" role="group" aria-label="Series">
        <button type="button" class="pill" aria-pressed="true" data-pill-all>
          All episodes <span class="pill-count" data-pill-count>{lessons.length}</span>
        </button>
        {
          series.map(({ id, count }) => (
            <button type="button" class="pill" aria-pressed="false" data-pill={id}>
              {SERIES_LABEL[id]} <span class="pill-count" data-pill-count>{count}</span>
            </button>
          ))
        }
      </div>
      <p class="status" id="lesson-filter-status" role="status"></p>
    </div>
    <div class="empty" hidden data-empty>
      <button type="button" class="link-btn" data-clear>Clear the filter</button>
    </div>
    <!-- One scroll box: the lessons and, while transcripts are searched, the lines found in them. -->
    <div class="results" data-results>
      <h3 class="section-head" data-episodes-head hidden>Episodes</h3>
      <ol class="list">
        {
          lessons.map(({ data, body }) => (
            <li
              data-lesson={lessonPath(data)}
              data-series={data.series}
              data-filter-text={[data.title, data.topic, body].filter(Boolean).join(' ')}
            >
              <a href={lessonPath(data)} aria-current={current(here === lessonPath(data))}>
                <span class="square" aria-hidden="true">
                  <span class="number">{data.number}</span>
                  <Icon name="check" class="check" />
                </span>
                <span class="row-text">
                  <span class="row-title">{data.title}</span>
                  <span class="row-sub">
                    {SERIES_LABEL[data.series]} {data.number}
                    {data.topic && <>, {data.topic}</>}
                  </span>
                </span>
                <span class="row-end">
                  <time datetime={isoDuration(data.audio.durationSeconds)}>
                    {formatDuration(data.audio.durationSeconds)}
                  </time>
                  <FinishedMark id={lessonPath(data)} />
                </span>
              </a>
            </li>
          ))
        }
      </ol>
      <button type="button" class="link-btn more" data-more-episodes hidden>Show more episodes</button>
      <section class="hits" aria-labelledby="transcript-hits-head" data-hits hidden>
        <h3 class="section-head" id="transcript-hits-head">In transcripts</h3>
        <p class="hits-note" data-hits-loading hidden>Loading transcripts…</p>
        <ol class="hit-groups" data-hit-groups></ol>
        <button type="button" class="link-btn more" data-more-lines hidden>Show more lines</button>
      </section>
    </div>
  </div>

  <footer class="side-foot">
    <Credit />
  </footer>
</nav>

<script>
  import '../lib/sidebar-ui';
</script>

<style>
  .side {
    display: flex;
    flex-direction: column;
    background: var(--surface);
  }
  p {
    margin: 0;
  }

  /* The site name, on the name tab of the episode art, is the link home. */
  .site-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    padding-inline-end: var(--space-8);
  }
  .wordmark {
    padding: 18px 22px 12px 20px;
    background: var(--paper-pronunciation);
    color: var(--print-ink);
    font: 700 2rem / 0.9 var(--font-serif);
    letter-spacing: -0.03em;
    text-decoration: none;
  }
  .wordmark:focus-visible {
    outline-offset: -4px;
    outline-color: var(--print-ink);
  }
  /* Lessons */
  .lessons {
    display: flex;
    flex-direction: column;
    padding-block-start: var(--space-16);
  }
  .lessons-head {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: 52px;
    padding: var(--space-4) var(--space-8) var(--space-4) 20px;
  }
  .lessons-head h2 {
    flex: 1;
    margin: 0;
    font-size: var(--text-28);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  /* Open: the field takes the heading's place in the row, and the button closes it. */
  .lessons-head:has([aria-expanded='true']) {
    align-items: start;
    padding-inline-start: var(--space-12);
  }
  .lessons-head:has([aria-expanded='true']) h2 {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .round {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    border: 0;
    border-radius: var(--radius-control);
    background: transparent;
    color: var(--muted);
  }
  .round:hover,
  .round[aria-expanded='true'] {
    background: var(--ink);
    color: var(--surface);
  }
  .round :global(.icon) {
    inline-size: 20px;
    block-size: 20px;
  }
  .round :global(.i-close),
  .round[aria-expanded='true'] :global(.i-open) {
    display: none;
  }
  .round[aria-expanded='true'] :global(.i-close) {
    display: block;
  }
  /* The field, with the transcripts checkbox under it. */
  .search {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-inline-size: 0;
  }
  .search[hidden] {
    display: none;
  }
  .field {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-inline-size: 0;
    min-block-size: 44px;
    padding-inline: 14px;
    border: 2px solid var(--control);
    border-radius: var(--radius-control);
    background: var(--surface);
  }
  /* It opens out of the button, leftwards across the row. */
  .search:not([hidden]) {
    animation: field-open 0.18s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @keyframes field-open {
    from {
      clip-path: inset(0 0 0 100%);
    }
    to {
      clip-path: inset(0);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .search:not([hidden]) {
      animation: none;
    }
  }
  .field:focus-within {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .field :global(.icon) {
    inline-size: 18px;
    block-size: 18px;
    color: var(--muted);
  }
  .field input {
    flex: 1;
    min-inline-size: 0;
    border: 0;
    background: transparent;
    outline: none;
    font-size: 1.0625rem;
  }
  /* The row's own button closes and clears the filter, so the browser's clear button would be a second ×. */
  .field input::-webkit-search-cancel-button {
    appearance: none;
  }

  .also {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: 36px;
    padding-inline: var(--space-4);
    color: var(--muted);
    font-size: var(--text-14);
    cursor: pointer;
  }
  .also input {
    inline-size: 18px;
    block-size: 18px;
    margin: 0;
    accent-color: var(--ink);
  }

  /* Series pills, each on its own paper (base.css sets --paper by data-pill); pressed is reversed
     out in ink. "All episodes" has no paper: it's stock with an ink rule. */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    padding: 10px var(--space-12) var(--space-8);
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-block-size: 36px;
    padding: 0 var(--space-12);
    border: 0;
    border-radius: var(--radius-control);
    background: var(--paper);
    color: var(--print-ink);
    font-weight: 700;
  }
  .pill[hidden] {
    display: none;
  }
  .pill[aria-pressed='true'] {
    background: var(--print-ink);
    color: var(--paper);
  }
  .pill[data-pill-all] {
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 2px var(--ink);
  }
  .pill[data-pill-all][aria-pressed='true'] {
    background: var(--ink);
    color: var(--surface);
    box-shadow: none;
  }
  .pill-count {
    font-size: var(--text-14);
    font-variant-numeric: tabular-nums;
    opacity: 0.8;
  }
  .status {
    padding: 0 20px var(--space-4);
    color: var(--muted);
    font-size: var(--text-14);
  }
  .status:empty {
    display: none;
  }

  /* Lesson rows: the number on a chip of the series' paper (base.css sets --paper by data-series). */
  .results {
    display: flex;
    flex-direction: column;
  }
  .more {
    align-self: start;
  }
  .list {
    margin: 0;
    padding: 0 var(--space-8) var(--space-8);
    list-style: none;
  }
  .list li[hidden] {
    display: none;
  }
  .list a {
    display: grid;
    grid-template-columns: 44px 1fr auto;
    gap: 14px;
    align-items: center;
    min-block-size: 56px;
    padding: var(--space-6) var(--space-8);
    border-radius: var(--radius-control);
    color: var(--ink);
    text-decoration: none;
  }
  .list a:hover {
    background: color-mix(in srgb, var(--ink) 7%, var(--surface));
  }
  /* The current lesson: its row on the series' paper, its chip reversed out in ink. */
  .list a[aria-current='page'] {
    background: var(--paper);
    color: var(--print-ink);
  }
  .list a[aria-current='page'] :is(.row-sub, .row-end) {
    color: color-mix(in srgb, var(--print-ink) 78%, var(--paper));
  }
  .square {
    display: grid;
    place-items: center;
    inline-size: 44px;
    block-size: 44px;
    background: var(--paper);
    color: var(--print-ink);
    font: 700 1.375rem / 1 var(--font-serif);
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.02em;
  }
  .square :global(.check) {
    display: none;
    inline-size: 20px;
    block-size: 20px;
    stroke-width: 3;
  }
  /* Started: the chip's paper with an ink corner. Finished: ink, with the check in the paper. */
  [data-state='started'] .square {
    background: linear-gradient(135deg, transparent 72%, var(--print-ink) 72%) var(--paper);
  }
  [data-state='finished'] .square,
  .list a[aria-current='page'] .square {
    background: var(--print-ink);
    color: var(--paper);
  }
  [data-state='finished'] .number {
    display: none;
  }
  [data-state='finished'] .square :global(.check) {
    display: block;
  }
  /* In the inverted print ink is the page: the corner and the finished chip are cut out of it. */
  @media (prefers-color-scheme: dark) {
    [data-state='started'] .square {
      background: linear-gradient(135deg, transparent 72%, var(--surface) 72%) var(--paper);
    }
    [data-state='finished'] .square {
      background: transparent;
      box-shadow: inset 0 0 0 2px var(--paper);
    }
  }
  .row-text {
    display: grid;
    min-inline-size: 0;
  }
  .row-title,
  .row-sub {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .row-title {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.25;
  }
  .row-sub {
    color: var(--muted);
    font-size: var(--text-14);
  }
  .row-end {
    color: var(--muted);
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
  }
  /* The square already shows a finished lesson; the mark stays for screen readers. */
  .row-end :global([data-finished]) {
    position: absolute;
    clip-path: inset(50%);
  }
  /* While transcripts are searched: the Episodes and In transcripts sections. */
  .section-head {
    margin: var(--space-8) 20px var(--space-4);
    color: var(--muted);
    font: 700 var(--text-14) / 1.3 var(--font-sans);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .section-head[hidden],
  .hits[hidden],
  .more[hidden],
  .hits-note[hidden] {
    display: none;
  }
  .more {
    margin-inline: 20px;
  }
  .hits {
    padding-block-end: var(--space-16);
  }
  .hits-note {
    padding: 0 20px;
    color: var(--muted);
    font-size: var(--text-14);
  }
  .hit-groups,
  .hit-groups :global(ol) {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hit-groups {
    padding-inline: var(--space-8);
  }
  .hit-groups :global(.hit-group) {
    margin-block-start: var(--space-12);
  }
  .hit-groups :global(.hit-lesson) {
    display: block;
    padding: var(--space-4) var(--space-8);
    color: var(--ink);
    font-weight: 700;
    text-decoration: none;
  }
  .hit-groups :global(.hit-lesson:hover) {
    text-decoration: underline;
  }
  /* The series' number chip, small, before the lesson's name. */
  .hit-groups :global(.hit-number) {
    display: inline-grid;
    place-items: center;
    min-inline-size: 1.75em;
    margin-inline-end: var(--space-8);
    padding: 1px 4px;
    background: var(--paper);
    color: var(--print-ink);
    font: 700 var(--text-14) / 1.3 var(--font-serif);
    font-variant-numeric: lining-nums tabular-nums;
  }
  .hit-groups :global(.hit) {
    display: grid;
    grid-template-columns: 3rem 1fr;
    gap: var(--space-8);
    inline-size: 100%;
    padding: var(--space-6) var(--space-8);
    border: 0;
    border-radius: var(--radius-control);
    background: none;
    color: var(--ink);
    font: inherit;
    font-size: var(--text-14);
    line-height: 1.4;
    text-align: start;
    cursor: pointer;
  }
  .hit-groups :global(.hit:hover) {
    background: color-mix(in srgb, var(--ink) 7%, var(--surface));
  }
  .hit-groups :global(.hit-time) {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }
  /* What matched: in ink on a tint of it, not the lessons' red highlights. */
  .hit-groups :global(mark) {
    border-radius: 2px;
    background: color-mix(in srgb, var(--ink) 16%, transparent);
    color: inherit;
  }
  .empty {
    padding: 0 20px var(--space-16);
  }
  .empty[hidden] {
    display: none;
  }

  .side-foot {
    padding: var(--space-12) 20px var(--space-16);
  }

  /* Desktop: the list scrolls inside the sidebar, and the footer stays pinned to its foot. */
  @media (min-width: 80rem) {
    .side {
      min-block-size: 0;
      overflow: hidden;
    }
    .lessons {
      flex: 1;
      min-block-size: 0;
    }
    .results {
      flex: 1;
      min-block-size: 0;
      overflow-y: auto;
    }
  }

  /* Phone: the whole view scrolls, so the heading row and pills stick to the top, as they stay put
     above the list on desktop. */
  @media (max-width: 79.99rem) {
    .lessons-top {
      position: sticky;
      inset-block-start: env(safe-area-inset-top, 0px);
      z-index: 1;
      padding-block-end: var(--space-4);
      background: var(--surface);
    }
  }
</style>
