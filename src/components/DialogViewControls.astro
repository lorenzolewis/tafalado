---
// "Show: Spanish, English, Highlights" above a lesson's dialog or clips (#93). The checkboxes drive
// the CSS on their own (`:has`). The inline script sets them to the learner's stored choice before
// the dialog is painted, so hidden lines don't flash; src/lib/dialog-view-ui.ts saves changes and
// keeps the choice for every lesson. Only the controls the dialog needs are shown.
import { DIALOG_VIEW_STORAGE } from '../lib/dialog-view';
import { storageKey } from '../lib/storage';

interface Props {
  /** The dialog has Spanish and English lines. */
  translations: boolean;
  /** The dialog's lines have `<mark>` highlights. */
  marks: boolean;
}
const { translations, marks } = Astro.props;
const key = storageKey(DIALOG_VIEW_STORAGE);
---

{
  (translations || marks) && (
    <fieldset class="dialog-view">
      <legend>Show</legend>
      {translations && (
        <label>
          <input type="checkbox" data-view="es" checked /> Spanish
        </label>
      )}
      {translations && (
        <label>
          <input type="checkbox" data-view="en" checked /> English
        </label>
      )}
      {marks && (
        <label>
          <input type="checkbox" data-view="marks" checked /> Highlights
        </label>
      )}
    </fieldset>
  )
}
{
  (translations || marks) && (
    <script is:inline define:vars={{ key }}>
      try {
        const view = JSON.parse(localStorage.getItem(key) ?? '{}');
        for (const box of document.currentScript.previousElementSibling.querySelectorAll('input[data-view]')) {
          if (typeof view?.[box.dataset.view] === 'boolean') box.checked = view[box.dataset.view];
        }
      } catch {
        // No storage: src/lib/dialog-view-ui.ts applies this visit's choice once loaded.
      }
    </script>
  )
}

<script>
  import '../lib/dialog-view-ui';
</script>

<style>
  .dialog-view {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 var(--space-16);
    margin: 0 0 var(--space-8);
    padding: 0;
    border: 0;
    font: var(--text-16) / 1.4 var(--font-sans);
  }
  legend {
    float: inline-start;
    margin-inline-end: var(--space-4);
    padding: 0;
    font-weight: 700;
  }
  label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-6);
    min-block-size: 44px;
    cursor: pointer;
  }
  input {
    inline-size: 1.125rem;
    block-size: 1.125rem;
    margin: 0;
    accent-color: var(--control);
  }

  /* Highlights off: the taught sounds in the lines read as plain text. A clip's heading and
     observations keep theirs: they explain the highlights. */
  :global(.dialog:has([data-view='marks']:not(:checked)) .turn mark) {
    color: inherit;
    font-weight: inherit;
    text-decoration-line: none;
  }

  /* A handout prints the dialog as chosen, without the controls. */
  @media print {
    .dialog-view {
      display: none;
    }
  }
</style>
