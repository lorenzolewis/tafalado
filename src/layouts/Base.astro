---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import Credit from '../components/Credit.astro';
import Icon from '../components/Icon.astro';
import Player from '../components/Player.astro';
import Sidebar from '../components/Sidebar.astro';
import TranscriptProtoShell from '../components/TranscriptProtoShell.astro';
import { APPLE_TOUCH_ICON_PATH, FAVICON_PATH, FAVICON_SIZES, OG_HEIGHT, OG_WIDTH, SITE_OG_PATH } from '../lib/artwork';
import { LESSONS_ID, pagePath, seriesOf, viewOf } from '../lib/nav';
import { INK, PAPER } from '../lib/print';
import { PODCAST_TITLE } from '../lib/podcast';
import { jsonLdScript, SITE_DESCRIPTION, THEME_COLOUR } from '../lib/seo';
import '../styles/base.css';
import '../styles/motion.css';

interface Props {
  /** Page title, before the site name. Omit on the home page. */
  title?: string;
  description?: string;
  /** Root-relative path of the page's Open Graph image (1200×630), e.g. from ogImagePath(). Defaults to the site's card (SITE_OG_PATH). */
  ogImage?: string;
  /** schema.org data for the page, from src/lib/seo.ts. */
  jsonLd?: object;
  /** Keep the page out of search results, with no canonical URL (the 404 page). @astrojs/sitemap leaves the 404 out by itself. */
  noindex?: boolean;
}

const {
  title,
  description = SITE_DESCRIPTION,
  ogImage = SITE_OG_PATH,
  jsonLd,
  noindex = false,
} = Astro.props;
// Canonical, og:url and og:image need absolute URLs, so they come from `site` (astro.config.ts).
if (!Astro.site) throw new Error('Set `site` in astro.config.ts: canonical URLs and og:image need it.');
const fullTitle = title ? `${title} · ${PODCAST_TITLE}` : PODCAST_TITLE;
const canonical = new URL(pagePath(Astro.url.pathname), Astro.site).href;
// Every page has a 1200×630 card (#77): a lesson page its own, every other page the site's, the 404 included.
const ogImageUrl = new URL(ogImage, Astro.site).href;
// The phone shows one view at a time (#53): this page's own (home or page), or the Lessons view,
// which src/lib/sidebar-ui.ts switches to when the URL ends in #lessons. The "‹ Lessons" button,
// pinned to the top of every page, opens it; the sidebar's site name leads back home.
const view = viewOf(Astro.url.pathname);
// The print's papers and ink, as the artwork uses them (src/lib/print.ts), for src/styles/base.css.
// A lesson page takes its series' paper (data-series), every other page the podcast cover's.
const printColours = [
  ...Object.entries(PAPER).map(([series, colour]) => `--paper-${series}: ${colour}`),
  `--print-ink: ${INK}`,
].join('; ');
---

<!doctype html>
<html lang="en" data-series={seriesOf(Astro.url.pathname)} style={printColours}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <!-- Icons and the home screen app (src/lib/artwork.ts, src/pages/manifest.webmanifest.ts). -->
    <link rel="icon" href={FAVICON_PATH} sizes={FAVICON_SIZES.map((size) => `${size}x${size}`).join(' ')} />
    <link rel="apple-touch-icon" href={APPLE_TOUCH_ICON_PATH} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={THEME_COLOUR.light} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={THEME_COLOUR.dark} />
    <!-- Added to an iPhone home screen: open standalone (no Safari bars), named in full under the
         icon, with the system status bar in light or dark to match the page. -->
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content={PODCAST_TITLE} />
    <meta name="application-name" content={PODCAST_TITLE} />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="alternate" type="application/rss+xml" title={PODCAST_TITLE} href="/feed.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={PODCAST_TITLE} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_WIDTH)} />
    <meta property="og:image:height" content={String(OG_HEIGHT)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {jsonLd && <script is:inline type="application/ld+json" set:html={jsonLdScript(jsonLd)} />}
    <!-- Preload only what every page shows first: the headings and the UI text. -->
    <Font cssVariable="--font-serif" preload={[{ weight: 700, style: 'normal' }]} />
    <Font cssVariable="--font-sans" preload={[{ weight: 400 }, { weight: 500 }, { weight: 700 }]} />
    <ClientRouter />
    <!-- Without JavaScript the phone can't switch views, so it shows the lessons below the page. -->
    <noscript><style>@media (max-width: 79.99rem) { .app .side { display: flex !important; order: 1; } }</style></noscript>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="app" data-view={view} data-app>
      <Sidebar />
      <main id="main" class="pane" tabindex="-1">
        <a class="back" href={`#${LESSONS_ID}`}>
          <Icon name="back" />
          Lessons
        </a>
        <slot />
        <footer class="pane-foot">
          <Credit />
        </footer>
      </main>
    </div>
    <!-- Outside <main>, and on every page, so it is kept across navigations (ADR 0001). -->
    <Player />
    {import.meta.env.DEV && <TranscriptProtoShell />}
    <script>
      import '../lib/motion';
    </script>
  </body>
</html>

<style>
  /* The sidebar and the page are two sheets on the board (--bg), square, with a gap around them. */
  .app {
    display: grid;
    gap: var(--panel-gap);
    /* viewport-fit=cover lets the page run under the notch in landscape, so keep clear of it. */
    padding: max(var(--panel-gap), env(safe-area-inset-top)) max(var(--panel-gap), env(safe-area-inset-right))
      var(--panel-gap) max(var(--panel-gap), env(safe-area-inset-left));
  }
  .pane {
    min-inline-size: 0;
    padding: var(--space-24) 20px var(--space-32);
    background: var(--surface);
  }
  .pane:focus {
    outline: none;
  }
  .pane > :global(*) {
    max-inline-size: 48rem;
  }
  .pane-foot {
    margin-block-start: 40px;
    padding-block-start: var(--space-16);
    border-block-start: 1px solid var(--line);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-4);
    min-block-size: 44px;
    padding: 0 var(--space-12) 0 var(--space-4);
    border-radius: var(--radius-control);
    background: var(--surface);
    color: var(--accent);
    font-weight: 700;
    text-decoration: none;
  }
  .back :global(.icon) {
    inline-size: 20px;
    block-size: 20px;
  }

  /* Desktop: the sidebar beside the main pane, each scrolling on its own. The player is laid over
     the foot of the window (src/components/Player.astro): the board's gap shows below the sheets
     while it's hidden, and once it's there the page runs on behind it, with no gap between them. */
  @media (min-width: 80rem) {
    .app {
      grid-template-columns: minmax(var(--sidebar-min), var(--sidebar-max)) 1fr;
      block-size: 100dvh;
    }
    .pane {
      min-block-size: 0;
      overflow-y: auto;
      /* Room to scroll the end of the page clear of the player, and focused content kept clear of it. */
      padding: 40px 48px calc(48px + var(--player-block-size, 0px));
      scroll-padding-block-end: var(--player-block-size, 0px);
    }
    /* The sidebar's credit is pinned to its foot, so the sidebar stops at the player's top edge. */
    .app > :global(.side) {
      margin-block-end: max(0px, var(--player-block-size, 0px) - var(--panel-gap));
    }
    .back,
    .pane-foot {
      display: none;
    }
  }

  /* Phone: one view at a time, edge to edge, with the "‹ Lessons" button pinned to the top of the
     page over whatever scrolls under it. */
  @media (max-width: 79.99rem) {
    .app {
      gap: 0;
      padding: env(safe-area-inset-top) env(safe-area-inset-right) 0 env(safe-area-inset-left);
    }
    .app:not([data-view='lessons']) > :global(.side),
    .app[data-view='lessons'] > .pane {
      display: none;
    }
    .back {
      position: fixed;
      inset-block-start: calc(env(safe-area-inset-top, 0px) + var(--space-12));
      inset-inline-start: calc(env(safe-area-inset-left, 0px) + var(--space-12));
      z-index: 3;
      box-shadow: 0 0 0 1px var(--line);
    }
    /* Clear of the button (12px down, 44px tall). A lesson page starts with its print instead,
       which the button sits over (src/pages/[series]/[number].astro). */
    .pane {
      padding-block-start: calc(var(--space-12) + 44px + var(--space-16));
    }
  }
</style>
