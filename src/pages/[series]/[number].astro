---
// A lesson page (#56): the lesson's print bleeds across the top of the pane, with the series and
// number on a paper tab rising into its foot, as on the episode art (#61); then the title, the facts,
// Play, the intro and a link down to the dialog and the study notes (#88), which follow. Portuguese and
// Spanish words in the intro and notes are marked as in docs/lesson-schema.md.
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Icon from '../../components/Icon.astro';
import PlayButton from '../../components/PlayButton.astro';
import Print from '../../components/Print.astro';
import Base from '../../layouts/Base.astro';
import { ogImagePath } from '../../lib/artwork';
import { formatDate, formatMinutes, isoDate, isoDuration } from '../../lib/format';
import { getLessons, lessonPath, lessonTitle, type Lesson } from '../../lib/lessons';
import { getNotes } from '../../lib/notes';
import { lessonDescription, podcastEpisodeLd } from '../../lib/seo';
import { SERIES_LABEL } from '../../lib/series';

export const getStaticPaths = (async () => {
  const lessons = await getLessons();
  return lessons.map((lesson) => {
    const [, series, number] = lessonPath(lesson.data).split('/');
    return { params: { series, number }, props: { lesson } };
  });
}) satisfies GetStaticPaths;

const { lesson } = Astro.props as { lesson: Lesson };
const { data } = lesson;
const { Content } = await render(lesson);
const description = lessonDescription(lesson.rendered?.html ?? '');
const notes = await getNotes(lesson);
const NotesContent = notes && (await render(notes.entry)).Content;
---

<Base
  title={lessonTitle(data)}
  description={description}
  ogImage={ogImagePath(data)}
  jsonLd={podcastEpisodeLd(data, description, Astro.site!)}
>
  <article class="lesson">
    <header>
      <div class="cover">
        <Print series={data.series} photo={data.photo} />
        <hgroup class="name">
          <p class="series">{SERIES_LABEL[data.series]} {data.number}</p>
          <h1>{data.title}</h1>
        </hgroup>
      </div>
      <p class="facts">
        First published <time datetime={isoDate(data.date)}>{formatDate(data.date)}</time>.{' '}
        <time datetime={isoDuration(data.audio.durationSeconds)}>{formatMinutes(data.audio.durationSeconds)}</time> of
        audio.{data.topic && ` Culture talk: ${data.topic}.`}
      </p>
      <PlayButton lesson={lesson} />
    </header>
    <div class="intro">
      <Content />
    </div>
    {
      notes && (
        <p class="transcript">
          <a href="#notes">
            <Icon name="doc" />
            <span>{notes.dialog || notes.clips ? 'Dialog & notes ↓' : 'Notes ↓'}</span>
          </a>
        </p>
      )
    }
    {
      notes && NotesContent && (
        <section id="notes" class="notes" aria-label="Dialog and notes">
          {notes.dialog && (
            <section class="dialog" aria-labelledby="dialog">
              <h2 id="dialog">Dialog</h2>
              <ol>
                {notes.dialog.map((turn) => (
                  <li class="turn">
                    <p class="speaker">{turn.speaker}</p>
                    <p class="pt" lang="pt-BR" set:html={turn.pt} />
                    <p class="es" lang="es" set:html={turn.es} />
                    <p class="en" lang="en" set:html={turn.en} />
                  </li>
                ))}
              </ol>
            </section>
          )}
          {notes.clips && (
            <section class="dialog" aria-labelledby="clips">
              <h2 id="clips">Clips</h2>
              {notes.clips.map((clip) => (
                <section class="clip">
                  <h3 set:html={clip.heading} />
                  <p class="speaker">{clip.speakers.join(', ')}</p>
                  <div class="turn">
                    {clip.lines.map((line) => (
                      <p class="pt" lang="pt-BR" set:html={line} />
                    ))}
                    {clip.translation && <p class="es" lang="es" set:html={clip.translation.es} />}
                    {clip.translation && <p class="en" lang="en" set:html={clip.translation.en} />}
                  </div>
                  <p class="observations">
                    <b>Observations:</b> <Fragment set:html={clip.observations} />
                  </p>
                </section>
              ))}
            </section>
          )}
          <div class="notes-body">
            <NotesContent />
          </div>
          <p class="source">
            <a href={notes.entry.data.source}>Original lesson on COERLL</a>
          </p>
        </section>
      )
    }
  </article>
</Base>

<style>
  /* How far the print reaches past the pane's padding (src/layouts/Base.astro) to its edges. */
  .lesson {
    --bleed-x: 20px;
    --bleed-y: var(--space-24);
  }

  /* The print, edge to edge: 27:14, two-thirds the height of the #55 frame. */
  .cover {
    margin: calc(-1 * var(--bleed-y)) calc(-1 * var(--bleed-x)) 0;
  }
  .cover :global(.print) {
    aspect-ratio: 27 / 14;
  }
  /* The wide frame crops a lot; the faces in these photos sit high, so keep the upper part. */
  .cover :global(.print img) {
    object-position: 50% 25%;
  }
  .name {
    margin: 0;
    padding: 0 var(--bleed-x);
  }
  /* The series and number on a tab of the series' paper, rising into the photo's bottom-left. */
  .series {
    position: relative;
    display: inline-block;
    margin: -58px 0 0 calc(-1 * var(--bleed-x));
    padding: 18px 24px 8px var(--bleed-x);
    background: var(--paper);
    color: var(--print-ink);
    font: 700 var(--text-21) / 1.2 var(--font-sans);
  }
  h1 {
    margin: var(--space-12) 0 0;
    font-size: clamp(2.75rem, 8vw, 5.5rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  .facts {
    max-inline-size: 36rem;
    margin: var(--space-16) 0 0;
    color: var(--muted);
  }

  .intro {
    max-inline-size: 38rem;
    margin-block-start: 40px;
    font: var(--text-21) / 1.55 var(--font-serif);
  }
  .intro :global(p) {
    margin: 0;
  }
  .intro :global(p + p) {
    margin-block-start: var(--space-16);
  }
  /* Portuguese words: bold, underlined in the series' paper, below the letters so they stay clear. */
  .intro :global(i[lang='pt-BR']),
  .notes-body :global(i[lang='pt-BR']),
  .dialog :global(i[lang='pt-BR']) {
    font-weight: 700;
    text-decoration: underline var(--paper);
    text-decoration-thickness: 0.16em;
    text-decoration-skip-ink: none;
    text-underline-offset: 0.14em;
  }
  /* In the inverted print the word takes the paper itself. */
  @media (prefers-color-scheme: dark) {
    .intro :global(i[lang='pt-BR']),
    .notes-body :global(i[lang='pt-BR']),
    .dialog :global(i[lang='pt-BR']) {
      color: var(--paper);
      text-decoration: none;
    }
  }

  /* The dialog and the study notes (#88), in the intro's measure. */
  .notes {
    max-inline-size: 38rem;
    margin-block-start: 56px;
    font: var(--text-18) / 1.55 var(--font-serif);
    scroll-margin-block-start: var(--space-24);
  }
  .notes h2,
  .notes-body :global(h2) {
    margin: 48px 0 var(--space-16);
    font-size: var(--text-28);
  }
  .dialog > h2 {
    margin-block-start: 0;
  }
  .notes h3 {
    margin: var(--space-32) 0 var(--space-4);
    font-size: var(--text-21);
  }
  .notes-body :global(p),
  .notes-body :global(ul),
  .notes-body :global(ol) {
    margin: 0 0 var(--space-16);
  }
  .notes-body :global(li + li) {
    margin-block-start: var(--space-4);
  }

  /* A turn: the speaker, then the Portuguese, the Spanish and the English, each a step quieter. */
  .dialog ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .turn {
    padding-block: var(--space-12);
    border-block-start: 1px solid var(--line);
    break-inside: avoid;
  }
  .turn p {
    margin: 0;
  }
  .speaker {
    margin: 0;
    font: 700 var(--text-14) / 1.4 var(--font-sans);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .turn .pt {
    font-size: var(--text-21);
    font-weight: 500;
  }
  .turn .es {
    font-style: italic;
  }
  .turn .en {
    color: var(--muted);
  }
  .observations {
    margin: var(--space-8) 0 0;
  }
  .observations b {
    font-family: var(--font-sans);
  }

  /* Tables scroll sideways on a phone rather than squeezing their columns. */
  .notes-body :global(table) {
    display: block;
    max-inline-size: 100%;
    overflow-x: auto;
    margin: 0 0 var(--space-16);
    border-collapse: collapse;
    font-size: var(--text-16);
  }
  .notes-body :global(th),
  .notes-body :global(td) {
    padding: var(--space-6) var(--space-12) var(--space-6) 0;
    border-block-end: 1px solid var(--line);
    text-align: start;
    vertical-align: top;
  }
  .notes-body :global(th) {
    font: 700 var(--text-14) / 1.4 var(--font-sans);
  }

  .source {
    margin: var(--space-32) 0 0;
    font: var(--text-16) / 1.4 var(--font-sans);
  }

  /* Print: the notes as a handout, tables whole, no turn or row split across pages. */
  @media print {
    .notes-body :global(table) {
      display: table;
      overflow: visible;
    }
    .notes-body :global(tr) {
      break-inside: avoid;
    }
    .notes h2,
    .notes-body :global(h2) {
      break-after: avoid;
    }
    .source a::after {
      content: ' (' attr(href) ')';
    }
  }

  .transcript {
    margin: var(--space-32) 0 0;
  }
  .transcript a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-8);
    min-block-size: 44px;
    color: var(--ink);
    font-size: var(--text-18);
    font-weight: 700;
    text-decoration-color: var(--paper);
    text-decoration-thickness: 4px;
    text-underline-offset: 4px;
  }

  /* Phone: the print bleeds to the pane's top, under the pinned "‹ Lessons" button. */
  @media (max-width: 51.99rem) {
    :global(.pane):has(> .lesson) {
      padding-block-start: var(--bleed-y);
    }
    /* "Tá Falado" on a print with no photo starts below the button (12px down, 44px tall). */
    :global(.back) + .lesson {
      --print-inset-top: calc(var(--space-12) + 44px);
    }
  }

  /* Desktop: at the pane's full width 27:14 would still be tall, so the height is capped and the
     photo crops wider. The text stays within 44rem. */
  @media (min-width: 52rem) {
    .lesson {
      --bleed-x: 48px;
      --bleed-y: 40px;
    }
    /* Over the pane's own cap on its children (src/layouts/Base.astro). */
    :global(.pane) > .lesson {
      max-inline-size: none;
    }
    .lesson > :not(header, .intro, .notes),
    header > :not(.cover),
    .name > * {
      max-inline-size: 44rem;
    }
    .cover :global(.print) {
      inline-size: 100%;
      max-block-size: min(41vh, 373px);
    }
  }
</style>
