---
// The home page (#53, with the old About page's "liner notes" from #58): the name and lede, the
// Continue card and, on a phone, its "All 46 lessons" row, then the credits, read like the back of a record sleeve.
// A roster of roles and names, each name opening its bio in place; the license written out as prose;
// then this site's own code. The roster comes from CREDITS.md (docs/adr/0005). The lesson list and
// its filter are in the sidebar (Base.astro).
import * as credits from '../../CREDITS.md';
import Icon from '../components/Icon.astro';
import Base from '../layouts/Base.astro';
import { parseCredits } from '../lib/credits';
import { getLessons, lessonPath, lessonTitle } from '../lib/lessons';
import { podcastApps } from '../lib/podcast';
import { podcastSeriesLd } from '../lib/seo';

const roles = parseCredits(await credits.compiledContent());
// The first visit's Continue card offers episode 1 (Pronunciation 1).
const lessons = await getLessons();
const first = lessons[0]!.data;
const firstMinutes = `${Math.ceil(first.audio.durationSeconds / 60)} min`;

// The feed's absolute URL, as src/pages/feed.xml.ts builds it, and the apps that can follow it.
const feed = new URL('/feed.xml', Astro.site).href;
const apps = podcastApps(feed);

const REPO = 'https://github.com/lorenzolewis/tafalado';
const ORIGINAL = 'https://www.coerll.utexas.edu/brazilpod/tafalado/';
---

<Base jsonLd={podcastSeriesLd(Astro.site!)}>
  <div class="home">
    <h1 lang="pt-BR">Tá Falado</h1>
    <p class="lede">
      An independent, unofficial archive of <i lang="pt-BR">Tá Falado</i>, a podcast of Brazilian Portuguese lessons
      for speakers of Spanish, recorded at the University of Texas at Austin in 2006 and 2007. All 46 lessons, with their
      dialogs and notes, from the <a href={ORIGINAL}>archived original site</a>, in a site that works on a phone.
    </p>
    <p class="muted">This site isn't affiliated with or endorsed by the University of Texas at Austin or COERLL.</p>

    <!-- Server-rendered as the first visit's card (episode 1), so it never pops in; src/lib/progress-ui.ts
         switches it to the lesson in progress, if there is one. -->
    <section class="continue" aria-labelledby="continue" data-continue data-first={lessonPath(first)}>
      <h2 id="continue" data-continue-heading>Start with the first lesson</h2>
      <p class="continue-title"><a data-continue-link href={lessonPath(first)}>{lessonTitle(first)}</a></p>
      <div class="meter" data-continue-meter hidden><span data-continue-bar></span></div>
      <p class="continue-row">
        <button type="button" class="btn" data-continue-play>
          <Icon name="play" /><span data-continue-verb>Play</span>
        </button>
        <span data-continue-left>{firstMinutes}</span>
      </p>
      <p class="visually-hidden" data-continue-time></p>
    </section>
    <button type="button" class="all-lessons" data-all-lessons>
      <span>All {lessons.length} lessons</span>
      <Icon name="back" class="next" />
    </button>

    <section aria-labelledby="follow">
      <h2 id="follow">Follow the podcast</h2>
      <p class="prose">
        All {lessons.length} lessons are also a podcast, in order, so your podcast app can download them and keep your
        place.
      </p>
      <ul class="apps">
        {
          apps.map(({ name, icon, href }) =>
            href ? (
              <li>
                <a href={href}>
                  <img src={icon} alt="" width="32" height="32" />
                  <span>{name}</span>
                  <Icon name="back" class="next" />
                </a>
              </li>
            ) : (
              <li class="soon">
                <img src={icon} alt="" width="32" height="32" />
                <span>
                  {name}
                  <span class="visually-hidden">, </span>
                </span>
                <span class="note">Coming soon</span>
              </li>
            ),
          )
        }
      </ul>
      <p class="feed-label" id="feed-label">Or paste the feed into any other podcast app:</p>
      <div class="feed">
        <input type="text" readonly value={feed} aria-labelledby="feed-label" data-feed-url />
        <button type="button" class="btn btn-accent" data-copy-feed>
          <Icon name="check" class="copied" />
          <span data-copy-label>Copy</span>
        </button>
      </div>
    </section>

    <section aria-labelledby="credits">
      <h2 id="credits">Credits</h2>
      <dl class="roster">
        {
          roles.map(({ role, people, html }) => (
            <div class="row">
              <dt>{role}</dt>
              {html ? (
                <dd class="support" set:html={html} />
              ) : (
                <dd>
                  {people.map((person) => (
                    <details>
                      <summary>
                        <span class="name" set:html={person.nameHtml} />
                        <span class="muted" set:html={person.lineHtml} />
                      </summary>
                      <div class="bio" set:html={person.bioHtml} />
                    </details>
                  ))}
                </dd>
              )}
            </div>
          ))
        }
      </dl>
      <p class="muted small">
        Tap a name for their bio, from the <a href={`${ORIGINAL}about.html`}>original About page</a> (2006–2007). The
        roles come from the lesson intros.
      </p>
    </section>

    <section aria-labelledby="license">
      <h2 id="license">License</h2>
      <p class="prose">
        <cite><span lang="pt-BR">Tá Falado</span>: Brazilian Portuguese Pronunciation for Speakers of Spanish</cite>, by
        the podcasting team from the University of Texas at Austin, hosted by Orlando R. Kelm and produced at the College
        of Liberal Arts. Published by COERLL (Center for Open Educational Resources and Language Learning), University of
        Texas at Austin, at <a href={ORIGINAL}>coerll.utexas.edu/brazilpod/tafalado</a>, archived on March 2, 2026, and
        no longer updated. © 2025, University of Texas at Austin. Licensed under{' '}
        <a href="https://creativecommons.org/licenses/by/3.0/">Creative Commons Attribution 3.0 Unported (CC BY 3.0)</a>.
      </p>
      <p class="prose">
        <strong>Modified: re-hosted and re-presented.</strong> The MP3s and photos are served unchanged, and
        the lesson titles and intros keep their original wording. The PDF transcripts were converted into each lesson's
        dialog and notes, with clear typos fixed. This site gives them new pages, a new player and a new podcast feed.
      </p>
      <p class="prose">
        The lesson photos come from the original lesson pages. Several show the team themselves; the rest are everyday
        scenes from the cultural topics. The original site doesn't credit any photo separately, so they're shared here
        under the same CC BY 3.0 license as the rest of the work. If you took one of these photos and would rather it
        not appear here, <a href={`${REPO}/issues`}>open an issue</a> and it will be removed.
      </p>
    </section>

    <section aria-labelledby="code">
      <h2 id="code">This site's code</h2>
      <p>
        The site's own code is separate from the content and MIT-licensed; the CC BY 3.0 license above covers the
        content. The podcast and episode artwork is set in{' '}
        <a href="https://www.huertatipografica.com/en/fonts/alegreya-ht-pro">Alegreya</a> and{' '}
        <a href="https://www.huertatipografica.com/en/fonts/alegreya-sans-ht">Alegreya Sans</a> by Juan Pablo del Peral
        (Huerta Tipográfica), under the SIL Open Font License.
      </p>
      <ul class="links">
        <li><a href={REPO}>Source code on GitHub</a></li>
        <li><a href={`${REPO}/blob/main/LICENSE`}>MIT license</a></li>
        <li><a href={`${REPO}/blob/main/CREDITS.md`}>CREDITS.md</a></li>
      </ul>
    </section>
  </div>
</Base>

<script>
  import { showAllLessons } from '../lib/sidebar-ui';

  /** Copies the feed URL, and says so on the button for a moment. */
  async function copyFeed(event: Event) {
    const button = event.currentTarget as HTMLButtonElement;
    const input = document.querySelector<HTMLInputElement>('[data-feed-url]');
    const label = button.querySelector('[data-copy-label]');
    if (!input || !label) return;
    try {
      await navigator.clipboard.writeText(input.value);
    } catch {
      // No clipboard (an insecure context, or permission refused): select it to copy by hand.
      input.select();
      return;
    }
    button.dataset.copied = '';
    label.textContent = 'Copied';
    setTimeout(() => {
      delete button.dataset.copied;
      label.textContent = 'Copy';
    }, 2000);
  }

  // Runs on every visit to the home page, since the ClientRouter only runs this script once.
  let page: AbortController | undefined;
  document.addEventListener('astro:page-load', () => {
    page?.abort();
    page = new AbortController();
    document.querySelector('[data-all-lessons]')?.addEventListener('click', showAllLessons, { signal: page.signal });
    document.querySelector('[data-copy-feed]')?.addEventListener('click', copyFeed, { signal: page.signal });
    // A tap on the field selects the whole URL, to copy by hand.
    document
      .querySelector<HTMLInputElement>('[data-feed-url]')
      ?.addEventListener('focus', (event) => (event.currentTarget as HTMLInputElement).select(), {
        signal: page.signal,
      });
  });
  document.addEventListener('astro:before-swap', () => page?.abort());
</script>

<style>
  .home {
    max-inline-size: 40rem;
  }
  p {
    margin: 0;
  }
  h1 {
    margin: 0 0 var(--space-12);
    font-size: var(--text-60);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .lede {
    margin-block-end: var(--space-12);
    font: var(--text-21) / 1.5 var(--font-serif);
  }
  .muted {
    color: var(--muted);
  }
  .small {
    margin-block-start: var(--space-12);
    font-size: var(--text-14);
  }
  section > h2 {
    margin: 48px 0 var(--space-16);
    font-size: var(--text-28);
  }

  /* The Continue card (#52): on the plate (src/styles/base.css), like the mini-player, with its bar
     and Play button in the plate's accent. */
  .continue {
    display: grid;
    gap: var(--space-8);
    margin-block-start: var(--space-32);
    padding: 20px;
    background: var(--plate);
    color: var(--on-plate);
  }
  .continue[hidden] {
    display: none;
  }
  .continue .btn {
    background: var(--plate-accent);
    color: var(--on-plate-accent);
  }
  .continue h2 {
    margin: 0;
    font: 500 var(--text-14) / 1.4 var(--font-sans);
  }
  .continue-title {
    font: 700 var(--text-28) / 1.1 var(--font-serif);
  }
  .continue-title a {
    color: inherit;
    text-decoration: none;
  }
  .continue :focus-visible {
    outline-color: var(--plate-accent);
  }
  .meter {
    block-size: 4px;
    margin-block: var(--space-4);
    background: var(--plate-track);
  }
  .meter[hidden] {
    display: none;
  }
  .meter > span {
    display: block;
    block-size: 100%;
    inline-size: 0;
    background: var(--plate-accent);
  }
  .continue-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-16);
    margin-block-start: var(--space-4);
    font-size: var(--text-14);
  }

  /* "All 46 lessons": a row under the card, ruled off like a list row, that opens the phone's Lessons
     view. Desktop has no need of it, since the sidebar is always in view there. */
  .all-lessons {
    display: flex;
    align-items: center;
    justify-content: space-between;
    inline-size: 100%;
    min-block-size: 52px;
    padding: 0 var(--space-4) 0 0;
    border: 0;
    border-block-end: 2px solid var(--ink);
    background: none;
    color: var(--ink);
    font: 700 var(--text-18) / 1.2 var(--font-sans);
    cursor: pointer;
    text-align: start;
  }
  .all-lessons:hover {
    color: var(--accent);
  }
  .all-lessons :global(.next) {
    transform: scaleX(-1);
  }
  @media (min-width: 80rem) {
    .all-lessons {
      display: none;
    }
  }

  /* Follow the podcast: the apps as ruled rows, like "All 46 lessons", two to a line on a wide
     screen; then the feed URL in a field with its Copy button. */
  .apps {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr));
    column-gap: var(--space-24);
    margin: var(--space-16) 0 0;
    padding: 0;
    border-block-start: 2px solid var(--ink);
    list-style: none;
  }
  .apps a,
  .soon {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    min-block-size: 56px;
    padding-inline-end: var(--space-4);
    border-block-end: 1px solid var(--line);
    color: var(--ink);
    font: 700 var(--text-18) / 1.2 var(--font-sans);
    text-decoration: none;
  }
  /* The apps' own icons, masked to the squircle-ish corner phones give them. */
  .apps img {
    flex: none;
    border-radius: 22%;
  }
  .apps a:hover span {
    text-decoration: underline;
  }
  .apps :global(.next) {
    inline-size: 20px;
    block-size: 20px;
    margin-inline-start: auto;
    transform: scaleX(-1);
  }
  /* Not listed in the app yet (src/lib/podcast.ts): greyed out, with no link. */
  .soon {
    color: var(--muted);
  }
  .soon img {
    filter: grayscale(1);
    opacity: 0.45;
  }
  .note {
    margin-inline-start: auto;
    font: 400 var(--text-14) / 1.2 var(--font-sans);
  }
  .feed-label {
    margin-block: var(--space-24) var(--space-8);
    color: var(--muted);
  }
  /* The Copy button drops under the field when the whole URL wouldn't fit beside it. */
  .feed {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }
  .feed input {
    flex: 999 1 19rem;
    min-inline-size: 0;
    min-block-size: 48px;
    padding: 0 var(--space-12);
    border: 2px solid var(--ink);
    border-radius: var(--radius-control);
    background: var(--surface);
    font-size: var(--text-16);
  }
  .feed .btn {
    flex: 1 0 7.5rem;
    justify-content: center;
  }
  .feed :global(.copied) {
    display: none;
  }
  .feed [data-copied] :global(.copied) {
    display: block;
  }

  /* The roster: the role on the left, the names on the right, a rule under each role. */
  .roster {
    margin: 0;
    border-block-start: 2px solid var(--ink);
  }
  .row {
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: var(--space-16);
    padding-block: var(--space-12);
    border-block-end: 1px solid var(--line);
  }
  dt {
    padding-block-start: 6px;
    color: var(--muted);
    font-weight: 500;
  }
  dd {
    margin: 0;
  }
  summary {
    display: grid;
    padding-block: 4px;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .name {
    font: 700 var(--text-21) / 1.25 var(--font-serif);
  }
  summary:hover .name {
    color: var(--accent);
  }
  .name::after {
    content: '+';
    margin-inline-start: 0.4em;
    color: var(--accent);
    font-family: var(--font-sans);
  }
  details[open] .name::after {
    content: '–';
  }
  .bio {
    padding: var(--space-8) 0 var(--space-12);
    font: var(--text-18) / 1.55 var(--font-serif);
  }
  .bio :global(p) {
    margin-block: 0 var(--space-12);
  }
  /* Support is plain text with its links; CREDITS.md italicizes the names. */
  .support {
    padding-block-start: 6px;
  }
  .support :global(em) {
    font-style: normal;
  }

  .prose {
    font: var(--text-18) / 1.55 var(--font-serif);
  }
  .prose + .prose {
    margin-block-start: var(--space-12);
  }
  .prose strong {
    font-family: var(--font-sans);
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8) var(--space-24);
    margin-block-start: var(--space-16);
    padding: 0;
    list-style: none;
    font-weight: 700;
  }

  @media (max-width: 30rem) {
    .row {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
