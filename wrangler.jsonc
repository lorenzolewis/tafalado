{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tafalado",
  "routes": [{ "pattern": "tafalado.lorenzo.soy", "custom_domain": true }],
  "compatibility_date": "2026-11-04",
  // A <version>-tafalado.<subdomain>.workers.dev link per version, so each PR's preview can be
  // opened (OG and structured-data checks). The plain workers.dev address stays off (routes set).
  // Wrangler warns that previews stay public: fine, the site is public anyway.
  "preview_urls": true,
  // The site is fully static (Astro's build output). This Worker only answers byte ranges
  // for MP3s, which static assets don't (ADR 0002).
  "main": "./worker/index.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /mp3/* invokes the Worker; every other path stays a free static-asset request.
    "run_worker_first": ["/mp3/*"]
  },
  // Rough MP3 download counts per episode (#8, worker/downloads.ts). Created on the first write;
  // read with the Analytics Engine SQL API (see README).
  "analytics_engine_datasets": [{ "binding": "DOWNLOADS", "dataset": "tafalado_downloads" }],
  // Workers Builds runs `wrangler preview` for non-production branches, which needs this block.
  "previews": {}
}
